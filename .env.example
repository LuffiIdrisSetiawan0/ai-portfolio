# ============================================================================
#  LLM configuration for the live multi-agent demo.
#  Copy this file to .env.local and fill in your values.
#  Without a key, the demo runs in a realistic "simulated" mode (no errors).
# ============================================================================

# "openai" (default — OpenAI-compatible gateways like Sumopod) or "anthropic"
LLM_PROVIDER=openai

# API base URL, INCLUDING the version path.
#   Sumopod (OpenAI-compatible):  https://ai.sumopod.com/v1
#   OpenAI:                        https://api.openai.com/v1
#   Anthropic native:             https://api.anthropic.com   (set LLM_PROVIDER=anthropic)
LLM_BASE_URL=https://ai.sumopod.com/v1

# Your API key (Sumopod / OpenAI / Anthropic).
LLM_API_KEY=

# The model id exactly as your provider exposes it.
#   e.g. claude-3-5-sonnet, claude-3-7-sonnet, gpt-4o-mini, etc.
LLM_MODEL=claude-3-5-sonnet

# Public site URL (used for SEO/OpenGraph metadata). Set on Vercel to your domain.
NEXT_PUBLIC_SITE_URL=https://localhost:3000
